# Candidate only. No service is created and all collection gates remain off.
PUBLIC_HISTORY_AUTH_ENABLED=false
PUBLIC_HISTORY_SAVE_ENABLED=false
PUBLIC_HISTORY_PRIVACY_APPROVED=false
PUBLIC_HISTORY_DELETION_AVAILABLE=false
PUBLIC_HISTORY_SITE_ORIGIN=
# Use the bare origin (e.g. https://mykcs.github.io); the Astro build's
# BASE_URL supplies the /the-community-lab/ Pages route prefix.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_HISTORY_REGION_LABEL=
PUBLIC_HISTORY_RETENTION_LABEL=
# Server only. Never prefix this secret with PUBLIC_ or put it in screenshots/logs.
# Vercel rollback function uses SUPABASE_SECRET_KEY here. Supabase Edge
# instead receives SUPABASE_SECRET_KEYS and SUPABASE_PUBLISHABLE_KEYS from
# its own runtime; enable HISTORY_ACCOUNT_DELETE_ENABLED there separately.
HISTORY_ACCOUNT_DELETE_ENABLED=false
SUPABASE_SECRET_KEY=
