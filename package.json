{
  "name": "the-community-lab",
  "version": "0.1.0",
  "description": "Astro and Tailwind bilingual Korean-Chinese values-test fan project",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --no-wasm-async-compilation --test",
