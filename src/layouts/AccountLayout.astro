---
import '../styles/global.css';
import '../styles/history.css';
const { title } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex" />
    <title>{title} · 同频实验室</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="回到同频实验室"><span class="brand-name">THE COMMUNITY <strong>LAB.</strong><small>同频实验室 · 非官方</small></span></a>
        <nav class="header-links" aria-label="主导航"><a href="/">返回测试</a><a href="/privacy">隐私说明</a></nav>
      </header>
      <main class="account-page" id="main-content"><slot /></main>
      <footer class="site-footer"><div class="footer-bottom"><span>独立粉丝项目 · 示例成绩不代表节目官方结果</span><a href="/privacy">隐私与数据选择</a></div></footer>
    </div>
  </body>
</html>
